{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // -----------------------------------------------------------------------
  // Microsoft Entra ID (旧 Azure AD) 認証設定
  //
  // ★ 各値の取得方法（Azure Portal の手順）：
  //   1. https://portal.azure.com を開く
  //   2. 「Microsoft Entra ID」→「アプリの登録」→「新規登録」
  //   3. TenantId  : 「概要」→「ディレクトリ（テナント）ID」
  //   4. ClientId  : 「概要」→「アプリケーション（クライアント）ID」
  //   5. CallbackPath: リダイレクト URI に登録した値（既定は /signin-oidc）
  //
  // ★ 開発環境では UseFakeAuth=true で本セクションは参照されない
  // -----------------------------------------------------------------------
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "YOUR_TENANT_ID",
    "ClientId": "YOUR_CLIENT_ID",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },

  // ローカル開発時の偽認証フラグ（本番では false にすること）
  "UseFakeAuth": false,

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=MyTodoAppDb;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;"
  }
}
