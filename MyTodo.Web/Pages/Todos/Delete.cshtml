@page
@model MyTodo.Web.Pages.Todos.DeleteModel

<h1>Delete Todo</h1>

<p>本当に削除しますか？</p>

<dl>
    <dt>ID</dt>
    <dd>@Model.Item.Id</dd>

    <dt>Title</dt>
    <dd>@Model.Item.Title</dd>
</dl>

<form method="post">
    <button type="submit" style="color:red;">Delete</button>
    <a asp-page="/Todos/Details" asp-route-id="@Model.Item.Id">Cancel</a>
</form>
