@page
@model MyTodo.Web.Pages.Todos.EditModel

<h1>Edit Todo</h1>

<form method="post">
    <div>
        <label>Title</label><br />
        <input asp-for="Input.Title" />
        <div asp-validation-for="Input.Title"></div>
    </div>

    <div style="margin-top: 8px;">
        <label>
            <input asp-for="Input.Done" />
            Done
        </label>
    </div>

    <button type="submit">Save</button>
</form>

<p>
    <a asp-page="/Todos/Index">Back to List</a>
</p>
