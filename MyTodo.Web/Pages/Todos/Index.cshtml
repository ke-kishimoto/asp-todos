@page
@model MyTodo.Web.Pages.Todos.IndexModel

<h1>Todos</h1>

<p>
    <a asp-page="/Todos/Create">Create New</a>
</p>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Done</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Title</td>
            <td>@item.Done</td>
            <td>@item.CreatedAt.ToLocalTime()</td>
            <td>
              <a asp-page="/Todos/Details" asp-route-id="@item.Id">Details</a>
            </td>
        </tr>
    }
    </tbody>
</table>
