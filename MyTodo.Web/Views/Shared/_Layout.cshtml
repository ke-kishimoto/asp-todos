<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyTodo.Web (MVC)</title>
    <base href="/" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyTodo.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                @* ★ MVC: asp-controller / asp-action でリンクを生成 *@
                @* ★ Razor Pages: asp-page="/Index" でリンクを生成 *@
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">MyTodo.Web</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            @* ★ MVC: asp-controller="Todos" asp-action="Index" でリンク生成 *@
                            <a class="nav-link text-dark fw-bold"
                               asp-controller="Todos" asp-action="Index">Todos (MVC)</a>
                        </li>
                        <li class="nav-item">
                            @* ★ Razor Pages 側への比較用リンク（asp-page を使う） *@
                            <a class="nav-link text-dark" asp-page="/Todos/Index">Todos (Razor Pages)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">Home (RP)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="BlazorTodos" asp-action="Index">Todos (Blazor Server)</a>
                        </li>
                    </ul>
                    <span class="navbar-text text-muted small">
                        【MVC レイアウト】Views/Shared/_Layout.cshtml
                    </span>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MyTodo.Web (MVC)
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
