<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyTodo.Web (MVC)</title>
    <base href="/" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/01-settings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/02-tools.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/03-generic.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/04-elements.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/05-objects.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/06-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/07-utilities.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyTodo.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="site-nav">
            <a class="site-nav__brand" asp-controller="Home" asp-action="Index">MyTodo.Web</a>
            <ul class="site-nav__links">
                <li>
                    <a class="site-nav__link" asp-controller="Todos" asp-action="Index">Todos (MVC)</a>
                </li>
                <li>
                    <a class="site-nav__link" asp-controller="BlazorTodos" asp-action="Index">Todos (Blazor)</a>
                </li>
                <li>
                    <a class="site-nav__link" asp-controller="Categories" asp-action="Index">Category (Blazor)</a>
                </li>
            </ul>
        </nav>
    </header>
    <div class="site-content">
        <center-l gutters="var(--s0)">
            <main role="main" style="padding-block-end: var(--s2);">
                @RenderBody()
            </main>
        </center-l>
    </div>

    <footer class="site-footer">
        <div class="site-footer__inner">
            &copy; 2026 - MyTodo.Web
        </div>
    </footer>

    <script type="module" src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

