@*
  ★ Razor Pages 対応ファイル: Pages/Todos/Edit.cshtml
  ★ MVC のモデル型: TodoItem
                   （Razor Pages は EditModel.Input プロパティ経由）
*@
@model MyTodo.Web.Controllers.TodosController.TodoInputEntity

@{
    ViewData["Title"] = "Edit Todo (MVC)";
}

<h1>Edit Todo <small class="text-muted fs-6">(MVC)</small></h1>

<form method="post" asp-controller="Todos" asp-action="Edit" asp-route-id="@Model.Id">
    <stack-l space="var(--s0)">
        <div class="form-group">
            <label class="form-label" asp-for="Title"></label>
            <input class="form-input" asp-for="Title" />
            <span asp-validation-for="Title" class="form-error"></span>
        </div>
        <div class="form-check">
            <input class="form-check__input" asp-for="Done" />
            <label class="form-check__label" asp-for="Done">Done</label>
        </div>
        <cluster-l space="var(--s-1)">
            <button type="submit" class="btn btn--primary">Save</button>
            <a asp-controller="Todos" asp-action="Index" class="btn btn--outline">Back to List</a>
        </cluster-l>
    </stack-l>
</form>
