@*
  ★ Razor Pages 対応ファイル: Pages/Todos/Index.cshtml
  ★ MVC のモデル型:           IReadOnlyList<TodoItem>
                              （Razor Pages は IndexModel.Items プロパティ経由）
*@
@model IReadOnlyList<MyTodo.Web.Controllers.TodosController.TodoViewModel>

@{
    ViewData["Title"] = "Todos (MVC)";
}

<stack-l space="var(--s0)">
<h1>Todos <small class="text-muted fs-6">(MVC)</small></h1>

<cluster-l space="var(--s-1)" align="center">
    <form asp-controller="Todos" asp-action="Search" method="get">
        <cluster-l space="var(--s-2)" align="center">
            <input class="form-input" style="min-inline-size:200px" type="text" name="keyword" placeholder="keyword" />
            <button type="submit" class="btn btn--outline">検索</button>
        </cluster-l>
    </form>
    <a asp-controller="Todos" asp-action="Create" class="btn btn--primary">Create New</a>
</cluster-l>

<table class="data-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Done</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @*
      ★ Razor Pages: @foreach (var item in Model.Items) { ... }
      ★ MVC        : @foreach (var item in Model) { ... }  ← Model がリスト自体
    *@
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Title</td>
            <td>@item.Done</td>
            <td>@item.CreatedAt.ToLocalTime()</td>
            <td>
                @*
                  ★ Razor Pages: asp-page="/Todos/Details" asp-route-id="@item.Id"
                  ★ MVC        : asp-controller="Todos" asp-action="Details" asp-route-id="@item.Id"
                *@
                <a asp-controller="Todos" asp-action="Details" asp-route-id="@item.Id">Details</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</stack-l>
