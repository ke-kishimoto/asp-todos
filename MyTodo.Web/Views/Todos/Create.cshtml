@*
  ★ Razor Pages 対応ファイル: Pages/Todos/Create.cshtml
  ★ MVC のモデル: なし（バリデーションエラー時は ViewData["EnteredTitle"] で復元）
*@

@{
    ViewData["Title"] = "Create Todo (MVC)";
}

<h1>Create Todo <small class="text-muted fs-6">(MVC)</small></h1>

<form method="post">
    <stack-l space="var(--s0)">
    <div class="form-group">
        <label class="form-label" for="title">Title</label>
        @*
          ★ Razor Pages: <input asp-for="Title" />
                          → [BindProperty] の Title プロパティにバインド
          ★ MVC        : name="title" でアクション引数 string title にバインド
                          バリデーションエラー時は ViewData で入力値を復元
        *@
        <input type="text" name="title" id="title"
               value="@ViewData["EnteredTitle"]" />
        @*
          ★ Razor Pages: <div asp-validation-for="Title"></div>
          ★ MVC        : asp-validation-summary でモデル全体のエラーを表示
        *@
        <div asp-validation-summary="ModelOnly" class="form-error"></div>
    </div>

    <cluster-l space="var(--s-1)">
        <button type="submit" class="btn btn--primary">Create</button>
        <a asp-controller="Todos" asp-action="Index" class="btn btn--outline">Back to List</a>
    </cluster-l>
</form>
