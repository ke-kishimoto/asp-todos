@*
  ★ Razor Pages 対応ファイル: Pages/Todos/Delete.cshtml
  ★ MVC のモデル型: TodoItem
                   （Razor Pages は DeleteModel.Item プロパティ経由）
*@
@model MyTodo.Web.Controllers.TodosController.TodoViewModel

@{
    ViewData["Title"] = "Delete Todo (MVC)";
}

<stack-l space="var(--s0)">
<h1>Delete Todo <small class="text-muted fs-6">(MVC)</small></h1>

<p>本当に削除しますか？</p>

<dl class="def-list">
    <dt>ID</dt>
    <dd>@Model.Id</dd>
    <dt>Title</dt>
    <dd>@Model.Title</dd>
</dl>

<form method="post" asp-controller="Todos" asp-action="Delete" asp-route-id="@Model.Id">
    <cluster-l space="var(--s-1)">
        <button type="submit" class="btn btn--danger">Delete</button>
        <a asp-controller="Todos" asp-action="Details" asp-route-id="@Model.Id" class="btn btn--outline">Cancel</a>
    </cluster-l>
</form>
</stack-l>
