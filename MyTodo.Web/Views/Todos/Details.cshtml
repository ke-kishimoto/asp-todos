@*
  ★ Razor Pages 対応ファイル: Pages/Todos/Details.cshtml
  ★ MVC のモデル型: TodoItem
                   （Razor Pages は DetailsModel.Item プロパティ経由）
*@
@model MyTodo.Web.Controllers.TodosController.TodoViewModel

@{
    ViewData["Title"] = "Todo Details (MVC)";
}

<stack-l space="var(--s0)">
<h1>Todo Details <small class="text-muted fs-6">(MVC)</small></h1>

<dl class="def-list">
    <dt>ID</dt>
    <dd>@Model.Id</dd>
    <dt>Title</dt>
    <dd>@Model.Title</dd>
    <dt>Done</dt>
    <dd>@Model.Done</dd>
    <dt>Created</dt>
    <dd>@Model.CreatedAt.ToLocalTime()</dd>
</dl>

<cluster-l space="var(--s-1)">
    <a asp-controller="Todos" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn--primary">Edit</a>
    <a asp-controller="Todos" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn--outline-danger">Delete</a>
    <a asp-controller="Todos" asp-action="Index" class="btn btn--outline">Back to List</a>
</cluster-l>
</stack-l>
