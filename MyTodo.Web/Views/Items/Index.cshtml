@*
  ★ MVC のモデル型：一覧表示のためにアイテムのリストを受け取る
  ViewData["UserName"] はコントローラーがセットしたログインユーザー名
*@
@model IReadOnlyList<MyTodo.Web.Models.ItemViewModel>

@{
    ViewData["Title"] = "品目一覧（要認証）";
}

<h1>品目一覧 <small class="text-muted fs-6">(MVC / 認証必須)</small></h1>

@*
  ★ 認証済みユーザーの情報を表示する例
  Controller で ViewData["UserName"] = User.Identity?.Name としてセット済み
*@
<div class="alert alert-success" role="alert">
    ✅ ログイン中：<strong>@ViewData["UserName"]</strong>
</div>

<p>
    @* asp-controller / asp-action タグヘルパーが href を自動生成する *@
    <a asp-controller="Items" asp-action="Create" class="btn btn-primary">新規登録</a>
</p>

@if (!Model.Any())
{
    <p class="text-muted">登録されている品目はありません。</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>品目コード</th>
                <th>品目名</th>
                <th>単価（円）</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.ItemCode</td>
                    <td>@item.ItemName</td>
                    <td>@item.Price.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>
}
