@*
  ★ Razor Pages 対応ファイル: Pages/Todos/Delete.cshtml
  ★ MVC のモデル型: TodoItem
                   （Razor Pages は DeleteModel.Item プロパティ経由）
*@
@model MyRazorCrud.Models.TodoItem

@{
    ViewData["Title"] = "Delete Todo (MVC)";
}

<h1>Delete Todo <small class="text-muted fs-6">(MVC)</small></h1>

<p>本当に削除しますか？</p>

<dl>
    <dt>ID</dt>
    @*
      ★ Razor Pages: @Model.Item.Id
      ★ MVC        : @Model.Id
    *@
    <dd>@Model.Id</dd>

    <dt>Title</dt>
    <dd>@Model.Title</dd>
</dl>

@*
  ★ Razor Pages: <form method="post"> だけでOK
  ★ MVC        : asp-route-id="@Model.Id" でルートに id を埋め込む
                 [ActionName("Delete")] により DeleteConfirmed アクションに紐づく
*@
<form method="post" asp-controller="Todos" asp-action="Delete" asp-route-id="@Model.Id">
    <button type="submit" style="color:red;">Delete</button>
    <a asp-controller="Todos" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</form>
